{
  "expo": {
    "name": "Setl8",
    "slug": "setl8",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08080F",
    "splash": {
      "backgroundColor": "#08080F"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#08080F"
      },
      "package": "com.setl8.app"
    },
    "ios": {
      "bundleIdentifier": "com.setl8.app",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "setl8"
  }
}
