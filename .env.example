# Setl8: example environment variables (names and placeholder values only).
# Copy the relevant block into the file named in its heading. Never commit real values.

# ---------------------------------------------------------------------------
# backend/.env   (read only through backend/src/config.ts)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="replace-with-a-long-random-string"
ADMIN_SECRET="replace-with-a-long-random-string"
PORT=3001
NODE_ENV="development"
CORS_ORIGIN=""

# Solana (devnet). Use your own RPC URL; the public endpoint is rate limited.
SOLANA_RPC_URL="https://api.devnet.solana.com"
VAULT_PROGRAM_ID="C3bvX2hkL76wXNobbyJPV5JpEPRFc3ksA4khR8WU9Rnk"
PROTOCOL_WALLET="<protocol-wallet-public-key>"
# Path to the protocol wallet keypair JSON (kept outside the repository)
PROTOCOL_WALLET_KEYPAIR="/path/to/protocol-wallet-keypair.json"
PAYOUT_VAULT_ADDRESS="<payout-vault-pda-public-key>"
USDC_DEVNET_MINT="<devnet-test-mint-public-key>"

# Price feeds
PYTH_ENDPOINT="https://hermes.pyth.network"
FINNHUB_API_KEY="<finnhub-api-key>"

# Payout heartbeat interval in hours (120 = 5 days)
VAULT_FIRE_INTERVAL_HOURS=120

# Optional Telegram integration (leave empty to disable)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_URL=""

# ---------------------------------------------------------------------------
# apps/trade/.env.local, apps/web/.env.local, apps/admin/.env.local
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="http://localhost:3001"
NEXT_PUBLIC_SOLANA_RPC="https://api.devnet.solana.com"
NEXT_PUBLIC_SOLANA_NETWORK="devnet"
NEXT_PUBLIC_PROTOCOL_WALLET="<protocol-wallet-public-key>"
NEXT_PUBLIC_PAYOUT_VAULT="<payout-vault-pda-public-key>"

# ---------------------------------------------------------------------------
# apps/mobile/.env
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_URL="http://localhost:3001"
EXPO_PUBLIC_WS_URL="http://localhost:3001"
