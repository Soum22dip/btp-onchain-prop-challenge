  // Crypto (81)
  BTC
  ETH
  SOL
  BNB
  XRP
  DOGE
  ADA
  AVAX
  LINK
  DOT
  LTC
  BCH
  UNI
  ATOM
  ETC
  APT
  OP
  ARB
  INJ
  SUI
  SEI
  NEAR
  FTM
  MATIC
  IMX
  STX
  RNDR
  MKR
  AAVE
  CRV
  SNX
  LDO
  COMP
  RUNE
  FIL
  ICP
  BLUR
  PEPE
  SHIB
  BONK
  FLOKI
  WLD
  DYDX
  GMX
  GRT
  ENS
  SUSHI
  AXS
  SAND
  MANA
  GALA
  CHZ
  APE
  FET
  THETA
  EOS
  XLM
  XMR
  ZEC
  KSM
  KAVA
  ONE
  CELO
  EGLD
  FLOW
  ALGO
  VET
  IOTA
  XTZ
  ZIL
  BAT
  HNT
  QNT
  MASK
  GNS
  RPL
  TON
  TRX
