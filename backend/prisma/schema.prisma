// =============================================================================
// Setl8 — Prisma Schema
// Database: PostgreSQL 15
// Matches TypeScript types in packages/types/src/index.ts exactly
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TraderStatus {
  ACTIVE
  BANNED
  SUSPENDED
}

enum AttemptStatus {
  ACTIVE
  PASSED
  FAILED
  ABANDONED
}

enum AttemptPhase {
  EVALUATION
  FUNDED
}

enum TokenSymbol {
  USDC
  USDT
  USD1
}

